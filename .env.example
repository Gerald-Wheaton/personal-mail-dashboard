# ── AI Provider ───────────────────────────────────────────────────────────────
# Set AI_PROVIDER to "anthropic" (default) or "openai"
AI_PROVIDER=anthropic

# Override the model (optional — defaults to claude-haiku-4-5-20251001 for Anthropic
# or gpt-4o-mini for OpenAI)
# AI_MODEL=claude-haiku-4-5-20251001

# API key for the active provider — only the one you use is required
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/db

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/auth/clients?project=personal-mail-dashboard
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENC_KEY=change-me-32-bytes-min
